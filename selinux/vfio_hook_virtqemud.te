module vfio_hook_virtqemud 1.0;

###############################################################################
# Local policy for the libvirt GPU-passthrough hooks.
#
# Libvirt runs /etc/libvirt/hooks/qemu in the virtqemud_t domain, so the helpers
# the hooks spawn inherit virtqemud_t. Fedora currently ships virtqemud_t as a
# PERMISSIVE domain, so they already succeed — this module turns the matching
# AVCs into explicit allows so the troubleshooter goes quiet and the hooks keep
# working if/when Fedora makes virtqemud_t enforcing.
#
# The GPU is bound/unbound by libvirt (<hostdev managed='yes'>). The hooks only:
#   * gpu_guard.sh: `find /proc/*/fd -lname <gpu node>` + ps to refuse start if
#     the GPU is busy (so libvirt's detach can't hang) -> reads other procs'
#     /proc dirs + fd symlinks (NOT socket targets -> no socket getattr);
#   * isolatecpu/reattachcpu: `systemctl set-property` for the cpusets;
#   * better_hugepages: write /proc/sys/vm.
#
# NOTE: libvirt's own vfio bind/unbind of the PCI device also runs as
# virtqemud_t and raised no AVCs in your logs (base policy covers it). If you
# flip virtqemud_t to enforcing and something passthrough-related is denied,
# regenerate: `ausearch -m avc -ts recent | audit2allow -m vfio_hook`.
###############################################################################
# PS:
# 1. This file is generated by claude opus 4.8.
# 2. If you want it "just works" and don't mind some warnings in journal 
# (or desktop if you have SELinux Troubleshooter installed), you can ignore it.
# Fedora ships with "permissive virtqemud_t" which will allow all hook scripts
# to work out of the box.
###############################################################################

require {
	type virtqemud_t;
	type init_t;
	type systemd_systemctl_exec_t;
	type systemd_unit_file_t;
	type sysctl_vm_t;
	attribute domain;
	class file { read write open getattr ioctl map execute execute_no_trans };
	class dir { getattr open search read };
	class lnk_file { read getattr };
	class dbus { send_msg };
	class system { start status };
	class service { start status };
	class capability { sys_ptrace };
	class cap_userns { sys_ptrace };
}

#============= gpu_guard.sh : scan /proc/<pid>/fd for GPU-node holders ==========
# `find -lname` reads each fd symlink and string-matches the GPU's node paths
# (it does NOT stat the fd targets -- that's deliberate: fuser/lsof would, which
# getattrs every socket of every process and floods the log). ps then names the
# holders by reading /proc/<pid>/stat. So we only need read-only access to other
# processes' /proc dirs, fd symlinks, and stat files -- visibility, not control,
# and no socket classes at all. Delete this block to keep the surface minimal
# and leave these reads permissive-logged instead.
allow virtqemud_t domain:dir { getattr open search read };
allow virtqemud_t domain:file { getattr open read };
allow virtqemud_t domain:lnk_file { getattr read };
# (find, ps, sed, sort, paste are bin_t, which virtqemud_t already execs.)

# find also reaches processes in CHILD user namespaces (flatpaks, browser
# sandboxes, containers); reading their fd symlinks trips ptrace_may_access ->
# CAP_SYS_PTRACE in that userns. We deliberately DON'T grant it -- ptrace is a
# real escalation for a VM-management daemon (it can read process memory). Since
# virtqemud_t is permissive today, find still reads them and detection stays
# complete; dontaudit just silences the noise.
#
# Trade-off if you later set virtqemud_t ENFORCING: find can't read a namespaced
# process's fds, so a GPU app running *inside* a flatpak/container becomes a
# detection blind spot (graceful -- it's skipped, the start isn't blocked). To
# cover that case under enforcing, replace these two lines with:
#     allow virtqemud_t self:cap_userns sys_ptrace;
#     allow virtqemud_t self:capability sys_ptrace;
dontaudit virtqemud_t self:cap_userns sys_ptrace;
dontaudit virtqemud_t self:capability sys_ptrace;

#============= isolatecpu.sh / reattachcpu.sh : systemctl set-property =============
# `systemctl set-property --runtime <slice> AllowedCPUs=...` execs systemctl,
# reads /proc/1 (covered by the domain rule above), and asks PID1 over D-Bus.
allow virtqemud_t systemd_systemctl_exec_t:file { read open getattr map execute execute_no_trans };
allow virtqemud_t init_t:dbus send_msg;
allow init_t virtqemud_t:dbus send_msg;
allow virtqemud_t init_t:system { start status };
allow virtqemud_t systemd_unit_file_t:service { start status };

#============= better_hugepages.sh : ease THP allocation (optional) =============
# echo 3 >/proc/sys/vm/drop_caches ; echo 1 >/proc/sys/vm/compact_memory
# Harmless system-wide (just frees/compacts cache). Drop this block if you'd
# rather remove the call from the hook than allow it.
allow virtqemud_t sysctl_vm_t:file { open write getattr };
