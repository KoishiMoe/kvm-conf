module vfio_hook_virtqemud 1.0;

###############################################################################
# Local policy for the PassthroughPOST GPU-passthrough libvirt hooks.
#
# Libvirt executes /etc/libvirt/hooks/qemu in the virtqemud_t domain, so every
# helper the hooks spawn (nvidia-smi, modprobe, virsh, systemctl, the THP
# tuning writes) inherits virtqemud_t. Fedora currently ships virtqemud_t as a
# PERMISSIVE domain, so these actions already succeed — this module only turns
# the matching AVCs into explicit allows so:
#   * the SELinux troubleshooter stops alerting on them, and
#   * the hooks keep working if/when Fedora makes virtqemud_t enforcing.
#
# Scope note (why this does NOT weaken the system meaningfully):
#   - It grants virtqemud_t exactly the operations VFIO passthrough requires:
#     touch the NVIDIA device nodes, (un)bind a PCI driver via sysfs, load/unload
#     modules, run virsh/systemctl, and free page cache. These are narrower than
#     the blanket "permissive virtqemud_t" Fedora ships by default.
#   - It deliberately does NOT grant the sudo/unix_chkpwd/shadow_t access that
#     the old notify-send-to.sh triggered; that path was removed in the script
#     instead. If you ever see shadow_t / sudo_exec_t / chkpwd_exec_t rules show
#     up when regenerating with audit2allow, drop them — they are a script bug,
#     not a needed permission.
###############################################################################
# PS:
# 1. This file is generated by claude opus 4.8.
# 2. If you want it "just works" and don't mind some warning popups in journal 
# (or desktop if you have SELinux Troubleshooter installed), you can ignore it.
# Fedora ships with "permissive virtqemud_t" which will allow all hook scripts
# to work out of the box.
###############################################################################

require {
	type virtqemud_t;
	type xserver_exec_t;
	type xserver_misc_device_t;
	type kmod_exec_t;
	type virsh_exec_t;
	type systemd_systemctl_exec_t;
	type systemd_unit_file_t;
	type device_t;
	type sysfs_t;
	type sysctl_vm_t;
	type init_t;
	class file { read write open getattr ioctl map execute execute_no_trans create };
	class chr_file { read write open getattr setattr ioctl create unlink };
	class lnk_file { read create unlink };
	class dir { search write add_name remove_name };
	class dbus { send_msg };
	class system { start status };
	class service { start status };
}

#============= bind_vfio.sh / unbind_vfio.sh : run nvidia-smi & friends =============
# Helper binaries are executed in-domain (execute_no_trans) by the hooks.
allow virtqemud_t xserver_exec_t:file { read open getattr map execute execute_no_trans ioctl };
allow virtqemud_t kmod_exec_t:file { read open getattr map execute execute_no_trans };
allow virtqemud_t virsh_exec_t:file { read open getattr map execute execute_no_trans };

# nvidia-smi -r resets the GPU: it pokes the nvidia control/uvm/caps nodes
# (xserver_misc_device_t) and recreates a few raw /dev nodes + symlinks (device_t).
allow virtqemud_t xserver_misc_device_t:chr_file { read write open getattr ioctl };
allow virtqemud_t device_t:chr_file { read write open getattr setattr ioctl create unlink };
allow virtqemud_t device_t:lnk_file { read create unlink };

# virsh nodedev-detach / nvidia unbind writes to /sys/bus/pci/.../driver/unbind.
allow virtqemud_t sysfs_t:dir { search write add_name remove_name };
allow virtqemud_t sysfs_t:file { read write open getattr create };

#============= isolatecpu.sh / reattachcpu.sh : systemctl set-property =============
# `systemctl set-property --runtime <slice> AllowedCPUs=...` execs systemctl,
# reads /proc/1, and asks PID1 (over D-Bus) to set the cpuset on the slices.
allow virtqemud_t systemd_systemctl_exec_t:file { read open getattr map execute execute_no_trans };
allow virtqemud_t init_t:lnk_file read;
allow virtqemud_t init_t:dbus send_msg;
allow init_t virtqemud_t:dbus send_msg;
allow virtqemud_t init_t:system { start status };
allow virtqemud_t systemd_unit_file_t:service { start status };

#============= better_hugepages.sh : ease THP allocation (optional) =============
# echo 3 >/proc/sys/vm/drop_caches ; echo 1 >/proc/sys/vm/compact_memory
# Harmless system-wide (just frees/compacts cache). Drop this block if you'd
# rather remove the call from the hook than allow it.
allow virtqemud_t sysctl_vm_t:file { open write getattr };
